      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const input = $json.body ?? $json;\nconst lead = {\n  nome: String(input.nome ?? '').trim(),\n  email: String(input.email ?? '').trim().toLowerCase(),\n  telefone: String(input.telefone ?? '').trim(),\n  empresa: String(input.empresa ?? '').trim(),\n  cargo: String(input.cargo ?? '').trim(),\n};\n\nconst obrigatoriosPreenchidos = Object.values(lead).every(Boolean);\nconst emailValido = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(lead.email);\nconst valido = obrigatoriosPreenchidos && emailValido;\n\nreturn {\n  json: {\n    ...lead,\n    valido,\n    status: valido ? 'qualificado' : 'inválido',\n  },\n};"
      },
