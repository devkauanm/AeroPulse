{
  "name": "AeroPulse — Automação de leads",
  "nodes": [
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const lead = $('Validar lead').item.json;\nconst consulta = $('Supabase — Verificar duplicidade').item.json;\n\nlet classificacao = 'N/A';\nlet status;\nlet detalhes_log = lead.motivoErro || null;\n\nif (lead.status === 'inválido') {\n  status = 'inválido';\n  detalhes_log = detalhes_log || 'Campos obrigatórios ausentes ou e-mail inválido';\n} else if (consulta.error) {\n  status = 'erro';\n  detalhes_log = 'Falha ao consultar duplicidade no Supabase';\n} else if (consulta.email) {\n  status = 'duplicado';\n  detalhes_log = 'E-mail já cadastrado anteriormente na base';\n} else {\n  // Captura e limpa a resposta do Gemini de qualquer texto extra\n  let respostaIA = '';\n  try {\n    const inputNode = $input.item.json;\n    const textoBruto = \n      inputNode?.content?.parts?.[0]?.text || \n      inputNode?.text || \n      inputNode?.response || \n      JSON.stringify(inputNode);\n      \n    const textoLower = textoBruto.toLowerCase();\n    if (textoLower.includes('quente')) respostaIA = 'quente';\n    else if (textoLower.includes('morno')) respostaIA = 'morno';\n    else if (textoLower.includes('frio')) respostaIA = 'frio';\n  } catch (e) {\n    respostaIA = '';\n  }\n\n  if (['quente', 'morno', 'frio'].includes(respostaIA)) {\n    classificacao = respostaIA;\n    detalhes_log = 'Classificado via IA (Google Gemini)';\n  } else {\n    // Fallback por Regex caso a IA falhe\n    const cargo = (lead.cargo || '').toLowerCase();\n    const empresa = (lead.empresa || '').toLowerCase();\n    const cargoDecisor = /\\b(ceo|cto|cfo|cio|coo|founder|fundador|presidente|diretor|diretora|vp|vice-presidente|chief|head)\\b/.test(cargo);\n    const empresaGrande = /\\b(enterprise|corp|corporation|global|multinacional|agro|engenharia|mineracao|energia)\\b/.test(empresa);\n    const cargoGestao = /\\b(manager|gerente|gestor|gestora|coordenador|coordenadora|supervisor|supervisora|engenheiro)\\b/.test(cargo);\n\n    if (cargoDecisor || empresaGrande) {\n      classificacao = 'quente';\n    } else if (cargoGestao) {\n      classificacao = 'morno';\n    } else {\n      classificacao = 'frio';\n    }\n    detalhes_log = 'Classificado via regra fixa (Fallback automático)';\n  }\n\n  status = classificacao === 'frio' ? 'nutrição' : 'enviado ao CRM';\n}\n\nreturn {\n  json: {\n    nome: lead.nome,\n    email: lead.email,\n    telefone: lead.telefone,\n    empresa: lead.empresa,\n    cargo: lead.cargo,\n    classificacao,\n    status,\n    detalhes_log,\n    created_at: new Date().toISOString(),\n  },\n};"
      },
